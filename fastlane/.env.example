# Copy to fastlane/.env and fill in. fastlane loads that file automatically.
# It is gitignored -- never commit real values.

# The AuthKey_XXXXXXXXXX.p8 filename, without the AuthKey_ prefix or .p8 suffix.
ASC_KEY_ID=

# App Store Connect > Users and Access > Integrations > App Store Connect API.
# A UUID shown above the key list, the same for every key in the account.
ASC_ISSUER_ID=

# Optional. Defaults to ~/.appstoreconnect/private_keys/AuthKey_$ASC_KEY_ID.p8
# ASC_KEY_PATH=
