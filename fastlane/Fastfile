default_platform(:ios)

# Authentication comes from an App Store Connect API key you own. Nothing secret
# lives in this repo. Set these before running a lane:
#
#   export ASC_KEY_ID=XXXXXXXXXX          # the AuthKey_XXXXXXXXXX.p8 filename
#   export ASC_ISSUER_ID=<uuid>           # App Store Connect > Users and Access > Integrations
#   export ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_$ASC_KEY_ID.p8
#
def require_env(name, hint)
  value = ENV[name].to_s.strip
  UI.user_error!("#{name} is empty or unset. #{hint}") if value.empty?
  value
end

def asc_api_key
  key_id = require_env("ASC_KEY_ID", "It is the AuthKey_XXXXXXXXXX.p8 filename.")
  issuer = require_env("ASC_ISSUER_ID", "Find it in App Store Connect > Users and Access > Integrations.")

  path = ENV["ASC_KEY_PATH"].to_s.strip
  path = "~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8" if path.empty?
  path = File.expand_path(path)
  UI.user_error!("No App Store Connect API key at #{path}") unless File.exist?(path)

  app_store_connect_api_key(key_id: key_id, issuer_id: issuer, key_filepath: path)
end

platform :ios do
  desc "Push the live listing's text fields from fastlane/metadata. No build, no review submission."
  lane :update_metadata do
    # edit_live targets the version that is already on sale. Apple allows a
    # subset of fields to change there without a new version: description,
    # release notes, promotional text, and the support/marketing/privacy URLs.
    # deliver skips any metadata file that does not exist, so only the files
    # present in fastlane/metadata are touched.
    deliver(
      api_key: asc_api_key,
      edit_live: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      automatic_release: false,
      # Opens an HTML preview and asks before anything is sent. Pass
      # `force:true` on the command line to skip it in CI.
      force: false
    )
  end
end
