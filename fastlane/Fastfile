default_platform(:ios)

# Authentication comes from an App Store Connect API key you own. Nothing secret
# lives in this repo -- fastlane/.env holds the values and is gitignored.
#
#   ASC_KEY_ID      the AuthKey_XXXXXXXXXX.p8 filename
#   ASC_ISSUER_ID   App Store Connect > Users and Access > Integrations
#   ASC_KEY_PATH    optional, defaults to ~/.appstoreconnect/private_keys/
#
def require_env(name, hint)
  value = ENV[name].to_s.strip
  UI.user_error!("#{name} is empty or unset. #{hint}") if value.empty?
  value
end

def asc_token
  key_id = require_env("ASC_KEY_ID", "It is the AuthKey_XXXXXXXXXX.p8 filename.")
  issuer = require_env("ASC_ISSUER_ID", "Find it in App Store Connect > Users and Access > Integrations.")

  path = ENV["ASC_KEY_PATH"].to_s.strip
  path = "~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8" if path.empty?
  path = File.expand_path(path)
  UI.user_error!("No App Store Connect API key at #{path}") unless File.exist?(path)

  Spaceship::ConnectAPI::Token.create(key_id: key_id, issuer_id: issuer, filepath: path)
end

# deliver wants the key as the hash that app_store_connect_api_key returns,
# not as a Spaceship token, so both shapes are available.
def asc_api_key
  key_id = require_env("ASC_KEY_ID", "It is the AuthKey_XXXXXXXXXX.p8 filename.")
  issuer = require_env("ASC_ISSUER_ID", "Find it in App Store Connect > Users and Access > Integrations.")

  path = ENV["ASC_KEY_PATH"].to_s.strip
  path = "~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8" if path.empty?
  path = File.expand_path(path)
  UI.user_error!("No App Store Connect API key at #{path}") unless File.exist?(path)

  # in_house matters because the API cannot tell an Enterprise team from a
  # regular one, and fastlane refuses to guess.
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer,
    key_filepath: path,
    in_house: false
  )
end

# Metadata filename -> App Store Connect attribute.
#
# Which of these Apple actually accepts depends on the version's state, and it
# is stricter than fastlane's own LOCALISED_LIVE_VALUES list suggests. On a
# READY_FOR_SALE version with nothing in "Prepare for Submission", a description
# edit comes back as "Attribute 'description' cannot be edited at this time" --
# that field needs a new app version. Promotional text is the one Apple intends
# for updating a live listing. The lane tries each field on its own and reports
# what was refused rather than giving up on the first rejection.
EDITABLE_FIELDS = {
  "description" => :description,
  "release_notes" => :whats_new,
  "promotional_text" => :promotional_text,
  "support_url" => :support_url,
  "marketing_url" => :marketing_url
}.freeze

platform :ios do
  desc "Push the live listing's text fields from fastlane/metadata. No build, no review submission."
  lane :update_metadata do |options|
    dry_run = options.fetch(:dry_run, false).to_s == "true"

    Spaceship::ConnectAPI.token = asc_token
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("Could not find the app on App Store Connect") if app.nil?

    # Prefer a version being prepared: it accepts every field, where a version
    # already on sale only accepts a few. Falls back to the live one so the
    # lane still works for a promotional text change between releases.
    version = app.get_edit_app_store_version || app.get_live_app_store_version
    UI.user_error!("No version to edit") if version.nil?
    UI.message("#{app.name} #{version.version_string} (#{version.app_store_state})")

    # deliver's own `upload_to_app_store` is the usual way to do this, but it
    # calls fetch_edit_app_info unconditionally. On an app with nothing in
    # "Prepare for Submission" that returns nil and retries for 15 minutes
    # before failing, so the live-only fields are written directly here.
    # Anchored to the Fastfile, because fastlane chdirs before running a lane.
    metadata_root = File.expand_path("metadata", FastlaneCore::FastlaneFolder.path)
    UI.user_error!("No metadata directory at #{metadata_root}") unless Dir.exist?(metadata_root)

    locales = version.get_app_store_version_localizations
    UI.message("locales: #{locales.map(&:locale).join(', ')}")

    changed = 0
    skipped = []
    refused = []
    locales.each do |localization|
      dir = File.join(metadata_root, localization.locale)
      unless Dir.exist?(dir)
        skipped << localization.locale
        next
      end

      updates = {}
      EDITABLE_FIELDS.each do |filename, attribute|
        path = File.join(dir, "#{filename}.txt")
        next unless File.exist?(path)

        value = File.read(path).strip
        current = localization.send(attribute).to_s.strip
        next if value == current

        updates[attribute] = value
        UI.message("#{localization.locale}: #{filename} (#{current.length} -> #{value.length} chars)")
      end

      if updates.empty?
        UI.message("#{localization.locale}: already up to date")
        next
      end

      if dry_run
        UI.important("#{localization.locale}: would update #{updates.keys.join(', ')} (dry run)")
        changed += 1
        next
      end

      # One field at a time, so a field Apple refuses does not block the others.
      updates.each do |attribute, value|
        begin
          localization.update(attributes: { attribute => value })
          UI.success("#{localization.locale}: updated #{attribute}")
          changed += 1
        rescue StandardError => e
          refused << "#{localization.locale}/#{attribute}"
          UI.error("#{localization.locale}: #{attribute} refused -- #{e.message.lines.first.to_s.strip}")
        end
      end
    end

    UI.important("no metadata directory for: #{skipped.join(', ')}") unless skipped.empty?

    unless refused.empty?
      UI.error("Apple refused: #{refused.join(', ')}")
      UI.error("A field refused on a live version usually needs a new app version in App Store Connect.")
    end

    if !refused.empty? && changed.zero?
      UI.user_error!("Nothing was updated -- every field was refused. See above.")
    elsif changed.zero?
      UI.important("Nothing to change -- the live listing already matches fastlane/metadata.")
    else
      UI.success(dry_run ? "Dry run finished, nothing sent." : "Done. #{changed} field(s) updated.")
    end
  end

  desc "Upload the screenshots in fastlane/screenshots to the version being prepared."
  lane :upload_screenshots do
    # deliver handles the screenshot sets and asset commits, which is a lot of
    # API choreography to hand-roll. It needs an editable version to exist --
    # see update_metadata for why it stalls when there is not one.
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      screenshots_path: File.expand_path("screenshots", FastlaneCore::FastlaneFolder.path),
      run_precheck_before_submit: false,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end
end
